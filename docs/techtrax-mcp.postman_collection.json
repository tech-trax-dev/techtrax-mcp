          {
            "key": "Accept",
            "value": "application/json, text/event-stream"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Mcp-Session-Id",
            "value": "{{sessionId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"notifications/initialized\"\n}",
          "options": {
            "raw": {
              "language": "json"
